# ===================================
# Flask Environment Configuration
# ===================================
# Copy this file to .env and update values for local development

# Flask Configuration
FLASK_SECRET_KEY=change-this-to-random-64-character-string
FLASK_ENV=development
FLASK_DEBUG=true

# Database Configuration
# For local development, use SQLite (default)
# DATABASE_URL is optional - if not set, uses db.sqlite3
# DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (production or local testing)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Application Settings
FRONTEND_ENCRYPTION_ENABLED=true
WEB_CONCURRENCY=2
LOG_LEVEL=debug

# Heroku Configuration (for deployment tracking)
HEROKU_APP_NAME=your-app-name
HEROKU_BRANCH=main
# HEROKU_PR_NUMBER=123

# Cloudflare Configuration (Optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AUTH_EMAIL=
CLOUDFLARE_AUTH_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SSL_HOSTS=

# ===================================
# Development Notes:
# ===================================
# 1. Never commit .env file to git (already in .gitignore)
# 2. Generate secure FLASK_SECRET_KEY with:
#    PowerShell:
#      $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [System.BitConverter]::ToString($bytes).Replace('-', '').ToLower()
#    Bash/Mac:
#      openssl rand -hex 32
# 3. For production (Heroku), set these via Config Vars in dashboard
# 4. SQLite is fine for development, use PostgreSQL for production

